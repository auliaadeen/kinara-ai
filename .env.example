GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

GOOGLE_CLOUD_PROJECT=
FIREBASE_PROJECT_ID=

# Public Web API key from Firebase Console > Project Settings > General.
# Used for password sign-up/sign-in via the Identity Toolkit REST API
# (Streamlit has no Firebase client SDK). Every token it returns is still
# verified server-side before any uid is trusted.
FIREBASE_WEB_API_KEY=

# Local development only. Point at an untracked service account JSON, or
# leave unset and run `gcloud auth application-default login` instead.
# Never commit the referenced file. Not needed on Cloud Run (uses the
# attached service account automatically).
# GOOGLE_APPLICATION_CREDENTIALS=