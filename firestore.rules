rules_version = '2';

// SECURITY.md: authorization is enforced in application code via
// firebase-admin (verified uid only, ARCHITECTURE.md #2). The Admin SDK
// bypasses these rules entirely, so this file is defense-in-depth only:
// no client ever talks to Firestore directly, so deny everything here.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
